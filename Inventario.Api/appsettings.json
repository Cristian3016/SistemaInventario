{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SistemaInventario.Api",
    "Audience": "SistemaInventario.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationHours": 12,
    "SessionIdleTimeoutMinutes": 15,
    "SessionMaxDurationHours": 12,
    "SessionWarningSeconds": 60
  }
}
