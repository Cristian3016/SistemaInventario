
@baseUrl = https://localhost:7076
@productoId = 2
@productoLGId = 5
@categoriaId = 1
@categoriaPerifericosId = 2
@productoEliminarId = 99999
@categoriaEliminarId = 99999

# ==========================================
# PRODUCTOS
# ==========================================

### GET - Obtener todos los productos
GET {{baseUrl}}/api/productos
Accept: application/json


### GET - Obtener producto por ID
GET {{baseUrl}}/api/productos/{{productoId}}
Accept: application/json


### POST - Crear producto nuevo
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Teclado Mecánico RGB",
  "descripcion": "Teclado mecánico para gaming",
  "codigoSku": "PER-001",
  "precio": 85000,
  "stock": 15,
  "stockMinimo": 5,
  "categoriaId": 2
}


### PUT - Actualizar producto completo
PUT {{baseUrl}}/api/productos/{{productoLGId}}
Content-Type: application/json

{
  "nombre": "Monitor LG 27 pulgadas",
  "descripcion": "Monitor IPS Full HD de 27 pulgadas",
  "codigoSku": "MON-002",
  "precio": 185000,
  "stock": 8,
  "stockMinimo": 3,
  "categoriaId": 1
}


### PATCH - Actualizar solamente el stock
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "stock": 20
}


### DELETE - Eliminar producto de prueba
DELETE {{baseUrl}}/api/productos/{{productoEliminarId}}
Accept: application/json


# ==========================================
# VALIDACIONES DE PRODUCTOS
# ==========================================

### POST - Comprobar SKU duplicado (409)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Monitor de prueba",
  "descripcion": "Prueba de SKU duplicado",
  "codigoSku": "MON-001",
  "precio": 150000,
  "stock": 10,
  "stockMinimo": 3,
  "categoriaId": 1
}


### PATCH - Comprobar SKU duplicado (409)
PATCH {{baseUrl}}/api/productos/{{productoLGId}}
Content-Type: application/json

{
  "codigoSku": "MON-001"
}


### PATCH - Comprobar stock mínimo negativo (400)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "stockMinimo": -5
}


### PATCH - Comprobar categoría inexistente (400)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "categoriaId": 99999
}


# ==========================================
# CATEGORÍAS
# ==========================================

### GET - Obtener todas las categorías
GET {{baseUrl}}/api/categorias
Accept: application/json


### GET - Obtener categoría por ID
GET {{baseUrl}}/api/categorias/{{categoriaId}}
Accept: application/json


### POST - Crear nueva categoría
POST {{baseUrl}}/api/categorias
Content-Type: application/json

{
  "nombre": "Impresoras",
  "descripcion": "Impresoras láser, tinta y multifunción"
}


### PUT - Actualizar categoría Periféricos
PUT {{baseUrl}}/api/categorias/{{categoriaPerifericosId}}
Content-Type: application/json

{
  "nombre": "Periféricos",
  "descripcion": "Teclados, mouse, auriculares, webcams y accesorios para computadoras"
}


### DELETE - Eliminar categoría de prueba
DELETE {{baseUrl}}/api/categorias/{{categoriaEliminarId}}
Accept: application/json


# ==========================================
# VALIDACIONES DE CATEGORÍAS
# ==========================================

### POST - Comprobar categoría duplicada (409)
POST {{baseUrl}}/api/categorias
Content-Type: application/json

{
  "nombre": "Monitores",
  "descripcion": "Categoría duplicada de prueba"
}

### PATCH - Comprobar categoría inexistente (400)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "categoriaId": 99999
}


### PATCH - Actualizar precio, stock y stock mínimo
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "precio": 175000,
  "stock": 15,
  "stockMinimo": 5
}

### GET - Obtener productos con stock bajo
GET {{baseUrl}}/api/productos/stock-bajo
Accept: application/json


### PATCH - Simular stock bajo
PATCH {{baseUrl}}/api/productos/2
Content-Type: application/json

{
  "stock": 3
}
###
GET {{baseUrl}}/api/productos/stock-bajo
Accept: application/json


### PATCH - Reponer stock del Monitor Samsung
PATCH {{baseUrl}}/api/productos/2
Content-Type: application/json

{
  "stock": 15
}

### MOVIMIENTOS DE STOCK

### POST - Registrar entrada de mercadería
POST {{baseUrl}}/api/movimientosstock
Content-Type: application/json

{
  "productoId": 2,
  "tipo": 1,
  "cantidad": 10,
  "observacion": "Ingreso de 10 monitores Samsung del proveedor"
}

###
POST {{baseUrl}}/api/movimientosstock
Content-Type: application/json

{
  "productoId": 2,
  "tipo": 2,
  "cantidad": 5,
  "observacion": "Venta de 5 monitores Samsung"
}















