
@baseUrl = https://localhost:7076
@productoId = 2
@productoLGId = 5
@categoriaId = 1002
@gasId = 1015

@abrasivosId = 1016

@productoEliminarId = 99999
@categoriaEliminarId = 99999


### ==========================================
### PRODUCTOS - GET
### ==========================================

### GET - Obtener todos los productos
GET {{baseUrl}}/api/productos
Accept: application/json

### GET - Obtener producto por ID
GET {{baseUrl}}/api/productos/{{productoId}}
Accept: application/json

### GET - Obtener productos con stock bajo
GET {{baseUrl}}/api/productos/stock-bajo
Accept: application/json


### ==========================================
### PRODUCTOS - POST
### ==========================================

### POST - Crear producto de ferretería con stock inicial
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Rollo de cable unipolar 2,5 mm² de 100 m",
  "descripcion": "Cable unipolar para instalaciones eléctricas, presentación de rollo completo",
  "codigoSku": "ELE-CAB-001",
  "precio": 15000,
  "stock": 10,
  "stockMinimo": 2,
  "categoriaId": 1003
}


### ==========================================
### PRODUCTOS - PUT
### ==========================================

### PUT - Actualizar Monitor LG existente
PUT {{baseUrl}}/api/productos/{{productoLGId}}
Content-Type: application/json

{
  "nombre": "Monitor LG 27 pulgadas",
  "descripcion": "Monitor IPS Full HD de 27 pulgadas",
  "codigoSku": "MON-002",
  "precio": 185000,
  "stock": 8,
  "stockMinimo": 3,
  "categoriaId": 1
}


### ==========================================
### PRODUCTOS - PATCH
### ==========================================

### PATCH - Cambiar precio sin modificar stock
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "precio": 175000
}

### PATCH - Validar cambio directo de stock (400)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "stock": 20
}

### PATCH - Validar stock mínimo negativo (400)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "stockMinimo": -5
}

### PATCH - Validar categoría inexistente (400)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "categoriaId": 99999
}


### ==========================================
### PRODUCTOS - DELETE
### ==========================================

### DELETE - Eliminar producto de prueba por ID
DELETE {{baseUrl}}/api/productos/{{productoEliminarId}}
Accept: application/json


### ==========================================
### CATEGORÍAS - GET
### ==========================================

### GET - Obtener todas las categorías
GET {{baseUrl}}/api/categorias
Accept: application/json

### GET - Obtener categoría por ID
GET {{baseUrl}}/api/categorias/{{categoriaId}}
Accept: application/json


### ==========================================
### CATEGORÍAS - POST
### ==========================================



### ==========================================
### CATEGORÍAS - PUT
### ==========================================

### PUT - Actualizar categoría Electricidad
PUT {{baseUrl}}/api/categorias/{{categoriaId}}
Content-Type: application/json

{
  "nombre": "Electricidad",
  "descripcion": "Materiales eléctricos, cables, protecciones, instalaciones y accesorios eléctricos.",
  "categoriaPadreId": null
}


### ==========================================
### CATEGORÍAS - DELETE
### ==========================================

### DELETE - Eliminar categoría de prueba por ID
DELETE {{baseUrl}}/api/categorias/{{categoriaEliminarId}}
Accept: application/json


### ==========================================
### MOVIMIENTOS DE STOCK - GET
### ==========================================

### GET - Obtener historial de movimientos
GET {{baseUrl}}/api/movimientosstock
Accept: application/json


### ==========================================
### MOVIMIENTOS DE STOCK - POST
### ==========================================

### POST - Registrar entrada de mercadería
POST {{baseUrl}}/api/movimientosstock
Content-Type: application/json

{
  "productoId": 2,
  "tipo": 1,
  "cantidad": 10,
  "observacion": "Ingreso de mercadería"
}

### POST - Registrar salida de mercadería
POST {{baseUrl}}/api/movimientosstock
Content-Type: application/json

{
  "productoId": 2,
  "tipo": 2,
  "cantidad": 5,
  "observacion": "Salida de mercadería"
}

### POST - Validar stock insuficiente (409)
POST {{baseUrl}}/api/movimientosstock
Content-Type: application/json

{
  "productoId": 2,
  "tipo": 2,
  "cantidad": 50000,
  "observacion": "Prueba de salida con stock insuficiente"
}


